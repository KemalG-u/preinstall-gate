{
  "schemaVersion": 3,
  "updatedAt": "2026-11-16",
  "knownCapabilities": [
    "text",
    "vision",
    "json_schema",
    "tools",
    "reasoning",
    "streaming",
    "embedding",
    "audio",
    "code_agent"
  ],
  "capabilityRoles": {
    "hizli-ucuz": {
      "title": "Hızlı ve Ekonomik",
      "description": "Kısa özetleme, ön sınıflandırma, etiketleme ve ucuz tarama işleri.",
      "minContextWindow": 16000,
      "requiredCapabilities": ["text"]
    },
    "dengeli": {
      "title": "Dengeli Anlatım",
      "description": "Modül açıklaması, günlük dil çevirisi, akış özeti ve standart analiz işleri.",
      "minContextWindow": 32000,
      "requiredCapabilities": ["text"]
    },
    "derin-mimari": {
      "title": "Derin Mimari ve Akıl Yürütme",
      "description": "Büyük ürünleri anlamlı organlara ayırma, iddia-gerçeklik (README vs kod) denetimi ve zor kararlar.",
      "minContextWindow": 64000,
      "requiredCapabilities": ["text", "reasoning"]
    },
    "kod-sokucu": {
      "title": "Özellik Ayıklama ve Kod Nakli",
      "description": "Seçilen modülün bağımlılıklarını çözüp başka bir projeye uyarlanabilir tarif/kod paketine dönüştürme.",
      "minContextWindow": 32000,
      "requiredCapabilities": ["text"]
    },
    "uzun-baglam": {
      "title": "Büyük Depo / Uzun Bağlam İncelemesi",
      "description": "120.000+ token üstü çok dosyalı proje özetlerini tek pencerede işleyebilen geniş bağlamlı modeller.",
      "minContextWindow": 120000,
      "requiredCapabilities": ["text"]
    },
    "gorsel-okuyucu": {
      "title": "Görsel / Ekran ve Diyagram Analizi",
      "description": "Ekran görüntülerini, arayüz tasarımlarını ve mimari şemaları okuyup çözümleme.",
      "minContextWindow": 32000,
      "requiredCapabilities": ["text", "vision"]
    },
    "vektor-gomme": {
      "title": "Metin ve Kod Vektörleştirme (Embedding)",
      "description": "Büyük kod tabanlarında veya belgelerde anlamsal arama için vektör üretimi.",
      "minContextWindow": 8000,
      "requiredCapabilities": ["embedding"]
    }
  },
